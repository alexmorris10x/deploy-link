@@ -0,0 +1,37 @@
+package tunnel
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+type terminalReadWriter struct {
+	err error
+}
+
+func (rw terminalReadWriter) Read([]byte) (int, error) {
+	return 0, rw.err
+}
+
+func (terminalReadWriter) Write(p []byte) (int, error) {
+	return len(p), nil
+}
+
+func TestEndpointDoneReportsTerminalReadError(t *testing.T) {
+	want := errors.New("outer transport stopped")
+	endpoint, err := RWCEndpointNew(terminalReadWriter{err: want}, 1500, 0)
+	require.NoError(t, err)
+	_, cancel := context.WithCancel(context.Background())
+	go endpoint.dispatchLoop(cancel)
+
+	select {
+	case got := <-endpoint.Done():
+		require.ErrorIs(t, got, want)
+	case <-time.After(time.Second):
+		t.Fatal("endpoint did not report terminal read error")
+	}
+}
