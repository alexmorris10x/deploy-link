new file mode 100644
index 0000000..3cfc665
--- /dev/null
+++ b/ios/zipconduit/zipconduit_context_test.go
@@ -0,0 +1,61 @@
+package zipconduit
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/danielpaulus/go-ios/ios"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNewWithShimConnectionContextBoundsRsdCheckin(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+
+	serverDone := make(chan error, 1)
+	go func() {
+		conn, acceptErr := listener.Accept()
+		if acceptErr != nil {
+			serverDone <- acceptErr
+			return
+		}
+		defer conn.Close()
+		preamble := make([]byte, 20)
+		if _, readErr := io.ReadFull(conn, preamble); readErr != nil {
+			serverDone <- readErr
+			return
+		}
+		_, copyErr := io.Copy(io.Discard, conn)
+		serverDone <- copyErr
+	}()
+
+	device := ios.DeviceEntry{
+		Address:          "fd00::1",
+		Rsd:              ios.RsdHandshakeResponse{Services: map[string]ios.RsdServiceEntry{shimServiceName: {Port: 62000}}},
+		UserspaceTUN:     true,
+		UserspaceTUNHost: "127.0.0.1",
+		UserspaceTUNPort: listener.Addr().(*net.TCPAddr).Port,
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	defer cancel()
+	started := time.Now()
+	_, err = NewWithShimConnectionContext(ctx, device)
+	require.Error(t, err)
+	assert.ErrorIs(t, err, context.DeadlineExceeded)
+	assert.Less(t, time.Since(started), time.Second)
+
+	select {
+	case serverErr := <-serverDone:
+		if serverErr != nil && !errors.Is(serverErr, net.ErrClosed) {
+			t.Fatalf("server did not finish cleanly after cancellation: %v", serverErr)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("server connection remained open after constructor cancellation")
+	}
+}
